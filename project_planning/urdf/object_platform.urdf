<?xml version="1.0"?>
<robot name="object_platform">
  <link name="object_platform_link">
    <inertial>
      <mass value="10.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 1.2 0.5"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.2 1.2 0.5"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="object_platform_link">
    <material>Gazebo/Blue</material>
    <static>true</static>
  </gazebo>
</robot>
