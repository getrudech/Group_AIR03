<?xml version="1.0"?>
<robot name="object_barrier">
  <link name="object_barrier_link">
    <inertial>
      <mass value="8.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 0.05 1.0"/>
      </geometry>
      <material name="orange">
        <color rgba="1 0.5 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 0.05 1.0"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="object_barrier_link">
    <material>Gazebo/Orange</material>
    <static>true</static>
  </gazebo>
</robot>
