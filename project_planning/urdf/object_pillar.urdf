<?xml version="1.0"?>
<robot name="object_pillar">
  <link name="object_pillar_link">
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0"
               iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="1.5"/>
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.1" length="1.5"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="object_pillar_link">
    <material>Gazebo/Red</material>
    <static>true</static>
  </gazebo>
</robot>
